# Qareer Quest — шаблон переменных Docker Compose
#
# Для локального запуска:
#   cp .env.example .env
#   docker compose up -d --build
#
# Значения local-* и статический TOTP_ENC_KEY предназначены только для локальной
# разработки. Перед production-запуском замените все пароли и ключи.

# =============================================================================
# Основные настройки — достаточно для запуска docker-compose.yml
# =============================================================================

POSTGRES_DB=devprep
POSTGRES_USER=devprep
POSTGRES_PASSWORD=local-postgres-password

JWT_SECRET=local-jwt-secret-change-me-at-least-32-characters
MEILI_MASTER_KEY=local-meili-master-key-change-me
# Валидный Base64-ключ длиной 32 байта, но небезопасный для production.
# Новый ключ: openssl rand -base64 32
TOTP_ENC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

PUBLIC_ORIGIN=http://localhost
COOKIE_SECURE=false

# Первый администратор. Оставьте пустыми, если автосидинг не нужен.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=local-admin-password

# =============================================================================
# Авторизация, cookie и защита от перебора
# =============================================================================

AUTH_ENABLED=true
REGISTRATION_ENABLED=false
COOKIE_SAME_SITE=Strict
COOKIE_DOMAIN=
LOCKOUT_ENABLED=true
LOCKOUT_MAX_ATTEMPTS=5
LOCKOUT_DURATION=PT15M
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW=PT10M
TOTP_REQUIRED_FOR_ADMINS=true

# =============================================================================
# Поиск и фичефлаги
# =============================================================================

MEILI_ENABLED=true
MEILI_MAX_TOTAL_HITS=1000
SEARCH_PAGE_SIZE=20
SEARCH_MAX_PAGE_SIZE=50
SEARCH_HEALTH_INTERVAL=PT30S
FLAGS_ENABLED=true
FLAGS_CACHE_TTL=PT15S

# =============================================================================
# Загрузка изображений в S3 / Cloudflare R2
# MEDIA_ENABLED=false позволяет запустить проект без этих реквизитов.
# =============================================================================

MEDIA_ENABLED=false
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
MEDIA_PUBLIC_BASE_URL=
MEDIA_MAX_FILE_SIZE=5MB

# =============================================================================
# SMTP и восстановление пароля
# Проект запускается с пустым SMTP_HOST, но письма отправляться не будут.
# =============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
PASSWORD_RESET_ENABLED=true
PASSWORD_RESET_MAIL_FROM=
PASSWORD_RESET_TTL=PT15M
PASSWORD_RESET_COOLDOWN=PT1M
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESET_TOTP=true

# =============================================================================
# API, логи, трассировка и Sentry
# =============================================================================

SPRINGDOC_ENABLED=false
MANAGEMENT_ENDPOINTS=health,info,prometheus
TRACING_SAMPLE_RATE=0.1
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://tempo:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
SENTRY_DSN=
SENTRY_ENVIRONMENT=local

# =============================================================================
# Мониторинг — docker-compose.observability.yml
# GRAFANA_ADMIN_PASSWORD обязателен при запуске этого overlay.
# =============================================================================

GRAFANA_ADMIN_PASSWORD=local-grafana-password
GRAFANA_ROOT_URL=http://localhost:3001
ALERT_TELEGRAM_CHAT_ID=
ALERT_MAIL_FROM=
ALERT_MAIL_TO=

# =============================================================================
# Резервное копирование — docker-compose.backup.yml
# Заполняйте только при подключении backup overlay.
# =============================================================================

BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_CIPHER_PASS=
BACKUP_TICK_SECONDS=86400
BACKUP_INITIAL_DELAY=60
BACKUP_FULL_INTERVAL_DAYS=7
BACKUP_VERIFY_INTERVAL_DAYS=7
BACKUP_LOGICAL_INTERVAL_DAYS=7
BACKUP_LOGICAL_KEEP=4
BACKUP_MAX_AGE_HOURS=30
BACKUP_WAL_MAX_AGE_MINUTES=15
BACKUP_PGWAL_MAX_MB=4096
BACKUP_ALERT_WEBHOOK=
VERIFY_MIN_QUESTION=1
VERIFY_MAX_DATA_AGE_DAYS=0

# =============================================================================
# Готовые образы — docker-compose.images.yml
# Раскомментируйте и укажите существующие теги при использовании этого overlay.
# =============================================================================

# API_IMAGE=ghcr.io/dimaandr840/quetion-site-api:<tag>
# WEB_IMAGE=ghcr.io/dimaandr840/quetion-site-web:<tag>

# =============================================================================
# TLS-скрипт scripts/setup-tls.sh
# Скрипт читает эти значения из окружения shell, а не напрямую из .env.
# Перед запуском выполните: set -a; source .env; set +a
# =============================================================================

DOMAIN=qareerquest.com
LETSENCRYPT_EMAIL=
DEPLOY_PATH=/opt/quetion-site
