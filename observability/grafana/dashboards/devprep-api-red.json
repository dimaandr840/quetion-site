{
  "uid": "devprep-api-red",
  "title": "DevPrep API — RED",
  "tags": ["devprep", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Доступность (5m)",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "devprep-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0.99,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.99 },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1 - devprep:api_error_ratio:rate5m",
          "legendFormat": "availability"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Rate — запросов/с по статусам",
      "gridPos": { "h": 9, "w": 12, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "devprep-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"devprep-api\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Errors — доля 5xx (5m)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "datasource": { "type": "prometheus", "uid": "devprep-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.005 },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "devprep:api_error_ratio:rate5m", "legendFormat": "5xx" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Duration — p95 / p99 (цель p95 < 500 мс)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "devprep-prometheus" },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        { "refId": "A", "expr": "devprep:api_latency_seconds:p95_5m", "legendFormat": "p95" },
        { "refId": "B", "expr": "devprep:api_latency_seconds:p99_5m", "legendFormat": "p99" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Пул соединений Postgres",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "devprep-prometheus" },
      "targets": [
        { "refId": "A", "expr": "hikaricp_connections_active{job=\"devprep-api\"}", "legendFormat": "active" },
        { "refId": "B", "expr": "hikaricp_connections_idle{job=\"devprep-api\"}", "legendFormat": "idle" },
        { "refId": "C", "expr": "hikaricp_connections_pending{job=\"devprep-api\"}", "legendFormat": "pending" },
        { "refId": "D", "expr": "hikaricp_connections_max{job=\"devprep-api\"}", "legendFormat": "max" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Поиск: индекс vs фолбэк",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "devprep-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (mode) (rate(devprep_search_requests_total{job=\"devprep-api\"}[5m]))",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Состояние зависимостей (1 = живо)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "devprep-prometheus" },
      "fieldConfig": { "defaults": { "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        { "refId": "A", "expr": "devprep_search_up{job=\"devprep-api\"}", "legendFormat": "meilisearch" },
        { "refId": "B", "expr": "devprep_media_up{job=\"devprep-api\"}", "legendFormat": "s3" },
        { "refId": "C", "expr": "devprep_mail_up{job=\"devprep-api\"}", "legendFormat": "smtp" }
      ]
    }
  ]
}
